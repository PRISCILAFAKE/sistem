<?php
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}
require_once __DIR__ . '/../Model/conexion.php';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $id_requerimiento = $_POST['id_requerimiento'] ?? null;
    $accion = $_POST['accion'] ?? null;
    $motivo_rechazo = $_POST['motivo_rechazo'] ?? null;

    if ($id_requerimiento && $accion) {
        try {
            $conexion->beginTransaction();

            $sqlCheck = "SELECT COUNT(*) FROM procesos WHERE id_requerimiento_fk = :id_req";
            $stmtCheck = $conexion->prepare($sqlCheck);
            $stmtCheck->execute([':id_req' => $id_requerimiento]);
            $existe = $stmtCheck->fetchColumn();

            if ($accion === 'aceptar') {
                $nuevo_estado = 'pendiente_gerencia';

                $stmt = $conexion->prepare("UPDATE requerimientos SET estado = ?, motivo_rechazo = NULL WHERE id_requerimiento = ?");
                $stmt->execute([$nuevo_estado, $id_requerimiento]);

                if ($existe > 0) {
                    $sqlProc = "UPDATE procesos SET estado = ?, motivo_rechazo = NULL, fecha_actualizada = NOW() WHERE id_requerimiento_fk = ?";
                    $stmtProc = $conexion->prepare($sqlProc);
                    $stmtProc->execute([$nuevo_estado, $id_requerimiento]);
                } else {
                    $sqlProc = "INSERT INTO procesos (id_requerimiento_fk, estado, motivo_rechazo, fecha_actualizada) VALUES (?, ?, NULL, NOW())";
                    $stmtProc = $conexion->prepare($sqlProc);
                    $stmtProc->execute([$id_requerimiento, $nuevo_estado]);
                }

            } elseif ($accion === 'rechazar') {
                $nuevo_estado = 'rechazado';

                $stmt = $conexion->prepare("UPDATE requerimientos SET estado = ?, motivo_rechazo = ? WHERE id_requerimiento = ?");
                $stmt->execute([$nuevo_estado, $motivo_rechazo, $id_requerimiento]);

                if ($existe > 0) {
                    $sqlProc = "UPDATE procesos SET estado = ?, motivo_rechazo = ?, fecha_actualizada = NOW() WHERE id_requerimiento_fk = ?";
                    $stmtProc = $conexion->prepare($sqlProc);
                    $stmtProc->execute([$nuevo_estado, $motivo_rechazo, $id_requerimiento]);
                } else {
                    $sqlProc = "INSERT INTO procesos (id_requerimiento_fk, estado, motivo_rechazo, fecha_actualizada) VALUES (?, ?, ?, NOW())";
                    $stmtProc = $conexion->prepare($sqlProc);
                    $stmtProc->execute([$id_requerimiento, $nuevo_estado, $motivo_rechazo]);
                }
            }
            
            $conexion->commit();
            header("Location: ../View/bandeja_jefe_view.php");
            exit();

        } catch (Exception $e) {
            if ($conexion->inTransaction()) {
                $conexion->rollBack();
            }
            die("Error al procesar la acción: " . $e->getMessage());
        }
    }
}
?>




